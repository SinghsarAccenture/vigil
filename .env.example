# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: only needed when routing through a proxy (e.g. Vocareum).
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-sonnet-4-6
# SEC requires a descriptive User-Agent with contact details.
SEC_USER_AGENT=Vigil regulatory monitor (your.name@example.com)
# Optional: defaults to vigil.db in the project root.
VIGIL_DB_PATH=
